# ==============================================================================
# Dockerfile for Document RAG Streamlit Frontend UI Service
# ==============================================================================
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install curl for Streamlit health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install python packages
COPY requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy UI code, application models/core (for schemas and optional DB summary), and evaluation reports
COPY ui /app/ui
COPY app /app/app
COPY eval /app/eval
COPY docs /app/docs

# Set Python path and environment variables
ENV PYTHONPATH=/app
ENV PORT=8501
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_ENABLE_CORS=false
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Expose default Streamlit port
EXPOSE 8501

# Streamlit internal health check endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8501}/_stcore/health || exit 1

# Start Streamlit bound to 0.0.0.0 reading dynamic $PORT from cloud provider
CMD ["sh", "-c", "streamlit run ui/app.py --server.port ${PORT:-8501} --server.address 0.0.0.0"]
