# ==============================================================================
# Document RAG Project - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Document RAG API"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL + pgvector)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/document_rag"

# LLM Provider Configuration (e.g., gemini, openai, mock)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"  # e.g., gemini-2.5-flash or gemini-flash-latest
GEMINI_API_KEY="your_gemini_api_key_here"
# LLM_API_KEY="your_llm_api_key_here"

# Embedding Model Configuration (Must match pgvector Vector(1536) schema)
EMBEDDING_PROVIDER="openai" # e.g., openai, voyage, or mock
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY="your_embedding_api_key_here"

# Reranker Configuration (e.g., flashrank for local CPU, cohere, mock)
RERANKER_PROVIDER="flashrank"
RERANKER_MODEL="ms-marco-TinyBERT-L-2-v2"
# RERANKER_API_KEY="your_cohere_key_if_using_cohere"
