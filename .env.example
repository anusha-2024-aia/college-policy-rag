# ==============================================================================
# Document RAG Project - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Document RAG API"
APP_ENV="development" # Set to "production" in cloud deployment
HOST="127.0.0.1"      # Set to "0.0.0.0" in Docker / Render
PORT=8000             # Overridden dynamically by $PORT in Render
DEBUG=False

# Database Configuration (PostgreSQL with pgvector extension)
# Local Docker format: postgresql://postgres:postgres@localhost:5432/document_rag
# Managed Cloud format (Neon / Supabase / Render):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_rag"

# Streamlit Frontend Client Target URL
# Point this to your live FastAPI backend domain in cloud deployment
BACKEND_API_URL="http://127.0.0.1:8000"

# LLM Provider Configuration (gemini, openai, or mock)
# Leave API key empty or placeholder to run offline with deterministic MockLLM
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="your_gemini_api_key_here"
# LLM_API_KEY="your_openai_or_other_key_here"

# Embedding Model Configuration (Legacy 1536-dimensional mock/OpenAI schema)
EMBEDDING_PROVIDER="mock" # "mock" for zero-cost offline, "openai" for OpenAI
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY="your_embedding_api_key_here"

# Semantic Retrieval Integration (384-dimensional local ONNX all-MiniLM-L6-v2)
# Set to "true" to activate 384-dimensional dense semantic retrieval over chunks_semantic
SEMANTIC_RETRIEVAL_ENABLED=false

# Reranker Configuration (FlashRank local CPU cross-encoder)
RERANKER_PROVIDER="flashrank"
RERANKER_MODEL="ms-marco-TinyBERT-L-2-v2"

# Version-Aware Policy Governance & RRF Settings
VERSION_AWARE_ENABLED=true
RRF_K=60
RETRIEVAL_K=20
RERANKER_TOP_N=5
